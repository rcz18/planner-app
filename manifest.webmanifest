{
  "name": "Planner",
  "short_name": "Planner",
  "description": "Video editing planner: open a project, preview the plan, edit its timeline, send it to Claude.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "background_color": "#121215",
  "theme_color": "#16161a",
  "icons": [
    {"src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any"},
    {"src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any"}
  ],
  "file_handlers": [
    {"action": "./", "accept": {"application/x-planner": [".planner"]}, "icons": [{"src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png"}], "launch_type": "single-client"}
  ]
}
